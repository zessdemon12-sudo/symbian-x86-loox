/* ==============================================================================
   Symbian Belle LXQt Theme - Panel & Widgets Stylesheet
   Color Palette: Deep Slate (#121920), Pure White (#FFFFFF), Symbian Cyan (#00A8FF)
   Optimized for Fujitsu FMV-BIBLO LOOX M/G30 (1024x600 Netbook LCD)
   ============================================================================== */

LXQtPanel #BackgroundWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(28, 38, 48, 240), stop:1 rgba(14, 20, 26, 250));
    border-top: 1px solid rgba(0, 168, 255, 120);
}

/* --- Symbian Belle Menu Button --- */
#MainMenu {
    background: transparent;
    padding: 2px 6px;
    border: none;
    border-radius: 4px;
}

#MainMenu:hover {
    background: rgba(0, 168, 255, 60);
    border: 1px solid rgba(0, 168, 255, 180);
}

#MainMenu:pressed {
    background: rgba(0, 168, 255, 120);
}

/* --- Taskbar Buttons (Symbian Squircle Styling) --- */
#TaskBar QToolButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(40, 52, 64, 180), stop:1 rgba(22, 30, 38, 200));
    color: #E0E8F0;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    margin: 2px 3px;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 5px;
}

#TaskBar QToolButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(0, 168, 255, 140), stop:1 rgba(0, 120, 200, 180));
    color: #FFFFFF;
    border: 1px solid #00A8FF;
}

#TaskBar QToolButton:on, #TaskBar QToolButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(0, 168, 255, 200), stop:1 rgba(0, 110, 180, 230));
    color: #FFFFFF;
    border: 1px solid #38C0FF;
    border-bottom: 2px solid #FFFFFF;
}

/* --- QuickLaunch Icons --- */
#QuickLaunch QToolButton {
    background: transparent;
    padding: 2px 4px;
    margin: 1px 2px;
    border-radius: 4px;
}

#QuickLaunch QToolButton:hover {
    background: rgba(0, 168, 255, 80);
    border: 1px solid rgba(0, 168, 255, 160);
}

/* --- System Tray & Status Widgets --- */
#Tray, #StatusNotifier, #Battery, #WorldClock, #Volume {
    padding: 2px 4px;
    color: #F0F4F8;
    font-size: 11px;
    font-weight: 600;
}

#WorldClock:hover, #Battery:hover, #Volume:hover {
    background: rgba(0, 168, 255, 60);
    border-radius: 4px;
}

/* --- Symbian Belle Popup Menus --- */
QMenu {
    background: rgba(18, 25, 33, 245);
    border: 1px solid rgba(0, 168, 255, 160);
    border-radius: 6px;
    padding: 4px;
    color: #FFFFFF;
}

QMenu::item {
    background: transparent;
    padding: 5px 24px 5px 12px;
    margin: 1px 0;
    border-radius: 4px;
    color: #E2E8F0;
}

QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0088DD, stop:1 #00A8FF);
    color: #FFFFFF;
    font-weight: bold;
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 40);
    margin: 4px 8px;
}

/* --- Tooltips --- */
QToolTip {
    background: #0E141A;
    color: #00A8FF;
    border: 1px solid #00A8FF;
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 11px;
}

#!/usr/bin/env python3
"""
Symbian-X86 LOOX OS - MMP Project Builder (mmp_builder)
Transforms Symbian .mmp project files into native x86 Makefiles and builds binaries.
"""

import os
import sys
import subprocess

def parse_mmp(mmp_path):
    config = {
        "target": "app.exe",
        "targettype": "exe",
        "uid3": "0x20000000",
        "secureid": "0x20000000",
        "capabilities": [],
        "sources": [],
        "sourcepath": ".",
        "userincludes": [],
        "systemincludes": [],
        "libraries": []
    }

    base_dir = os.path.dirname(os.path.abspath(mmp_path))

    with open(mmp_path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("//") or line.startswith("#"):
                continue

            parts = line.split()
            cmd = parts[0].upper()

            if cmd == "TARGET":
                config["target"] = parts[1]
            elif cmd == "TARGETTYPE":
                config["targettype"] = parts[1].lower()
            elif cmd == "UID":
                if len(parts) > 2:
                    config["uid3"] = parts[2]
                else:
                    config["uid3"] = parts[1]
            elif cmd == "SECUREID":
                config["secureid"] = parts[1]
            elif cmd == "CAPABILITY":
                config["capabilities"].extend(parts[1:])
            elif cmd == "SOURCEPATH":
                config["sourcepath"] = os.path.normpath(os.path.join(base_dir, parts[1]))
            elif cmd == "SOURCE":
                for src in parts[1:]:
                    config["sources"].append(os.path.join(config["sourcepath"], src))
            elif cmd == "USERINCLUDE":
                for inc in parts[1:]:
                    config["userincludes"].append(os.path.normpath(os.path.join(base_dir, inc)))
            elif cmd == "SYSTEMINCLUDE":
                for inc in parts[1:]:
                    config["systemincludes"].append(inc)
            elif cmd == "LIBRARY":
                config["libraries"].extend(parts[1:])

    return config

def generate_makefile(config, output_makefile="Makefile"):
    target = config["target"]
    is_dll = config["targettype"] in ("dll", "so")

    cflags = ["-Wall", "-O2"]
    if is_dll:
        cflags.append("-fPIC")

    # Includes
    sdk_root = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
    sdk_include = os.path.join(sdk_root, "include")
    cflags.append(f"-I{sdk_include}")

    for inc in config["userincludes"]:
        cflags.append(f"-I{inc}")
    for inc in config["systemincludes"]:
        cflags.append(f"-I{inc}")

    ldflags = []
    if is_dll:
        ldflags.append("-shared")

    sources = " ".join(config["sources"])
    cflags_str = " ".join(cflags)
    ldflags_str = " ".join(ldflags)

    makefile_content = f"""# Auto-generated by Symbian-X86 mmp_builder
CXX ?= g++
CXXFLAGS = {cflags_str}
LDFLAGS = {ldflags_str}
TARGET = {target}
SOURCES = {sources}

all: $(TARGET)

$(TARGET): $(SOURCES)
	$(CXX) $(CXXFLAGS) -o $@ $(SOURCES) $(LDFLAGS)

clean:
	rm -f $(TARGET)
"""
    with open(output_makefile, "w") as f:
        f.write(makefile_content)

    print(f"[MMP-BUILDER] Generated Makefile for target: {target}")
    return output_makefile

def main():
    if len(sys.argv) < 2:
        print("Usage: mmp_builder <project.mmp> [--build]")
        sys.exit(1)

    mmp_file = sys.argv[1]
    cfg = parse_mmp(mmp_file)
    mf = generate_makefile(cfg, os.path.join(os.path.dirname(mmp_file), "Makefile"))

    if "--build" in sys.argv:
        print("[MMP-BUILDER] Invoking make...")
        subprocess.check_call(["make", "-C", os.path.dirname(mmp_file)])

if __name__ == "__main__":
    main()

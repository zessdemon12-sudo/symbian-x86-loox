#!/usr/bin/env python3
"""
Symbian-X86 LOOX OS - Symbian Resource Compiler (rcomp)
Compiles Symbian .rss resource definition files into binary .rsc files.
"""

import os
import sys
import struct

def compile_rss(rss_path, output_rsc):
    print(f"[RCOMP] Compiling resource file: {rss_path} -> {output_rsc}")
    
    strings = []
    with open(rss_path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line.startswith("LTEXT") or "string" in line.lower():
                # Extract text between quotes
                start = line.find('"')
                end = line.rfind('"')
                if start != -1 and end != -1 and end > start:
                    strings.append(line[start+1:end])

    # Write binary RSC structure
    # Header: RSC Signature (0x101F4CD2), version, strings count
    with open(output_rsc, "wb") as f:
        f.write(struct.pack("<III", 0x101F4CD2, 1, len(strings)))
        for s in strings:
            encoded = s.encode("utf-8")
            f.write(struct.pack("<H", len(encoded)))
            f.write(encoded)

    print(f"[RCOMP] Compiled {len(strings)} resource strings into {output_rsc}")

if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("Usage: rcomp -u -s<input.rss> -o<output.rsc>")
        sys.exit(1)

    in_file = None
    out_file = None
    for arg in sys.argv[1:]:
        if arg.startswith("-s"):
            in_file = arg[2:]
        elif arg.startswith("-o"):
            out_file = arg[2:]

    if not in_file or not out_file:
        in_file = sys.argv[1]
        out_file = sys.argv[2]

    compile_rss(in_file, out_file)
